# ==========================================
# KrishiMitra - Environment Configuration
# State: Karnataka, India
# ==========================================

# Application
APP_ENV=development
APP_NAME=KrishiMitra
APP_PORT=8000
SECRET_KEY=krishimitra_super_secret_jwt_key_karnataka_2026_aiml
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database (SQLite for local development, PostgreSQL ready for production)
DATABASE_URL=sqlite:///./krishimitra.db
# DATABASE_URL=postgresql://postgres:password@localhost:5432/krishimitra_db

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://127.0.0.1:5173"]

# Data & Model Paths
RAW_DATA_PATH=data/raw/karnataka_agmarknet_historical_2021_2026.csv
MODELS_DIR=models/

# SMS Provider Configuration (India Transactional SMS Gateway / Fast2SMS / CDAC mKisan)
SMS_ENABLED=true
SMS_PROVIDER=mock_gateway # Change to 'fast2sms' or 'twilio' in production
SMS_API_KEY=YOUR_SMS_GATEWAY_API_KEY
SMS_SENDER_ID=KMITRA

# External Weather API (Open-Meteo / IMD Agricultural Meteorological Services)
WEATHER_API_URL=https://api.open-meteo.com/v1/forecast

# Ingestion Scheduling
DATA_REFRESH_INTERVAL_HOURS=24
